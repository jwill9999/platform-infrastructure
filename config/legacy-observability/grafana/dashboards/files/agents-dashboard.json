    {
      "id": 34,
      "type": "barchart",
      "title": "Spend Over Time (Last 30 Days)",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 54
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (date) (openrouter_activity_cost_dollars)",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "date": "Date",
              "Value": "Cost (USD)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Date"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "xField": "Date"
      }
    },
    {
      "id": 35,
      "type": "table",
      "title": "Model Breakdown (Last 30 Days, account-wide)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (model) (openrouter_activity_cost_dollars)",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (model) (openrouter_activity_tokens)",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "model": "Model",
              "Value #A": "Cost (USD)",
              "Value #B": "Tokens"
            }
          }
