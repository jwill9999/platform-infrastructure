{
  "uid": "vps-agents-usage-cost",
  "title": "VPS Agents - Usage & Cost",
  "tags": [
    "agents",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 14,
  "refresh": "5m",
  "time": {
    "from": "now/M",
    "to": "now/M"
  },
  "timepicker": {
    "quick_ranges": [
      {
        "display": "This month",
        "from": "now/M",
        "to": "now/M"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      },
      {
        "display": "Last 30 days",
        "from": "now-30d",
        "to": "now"
      },
      {
        "display": "Last 3 months",
        "from": "now-3M",
        "to": "now"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Claude Code CLI (VPS agent, subscription)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost \u2014 Selected Period (notional, see note)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(claude_code_cost_usage_USD_total[$__range]))",
          "legendFormat": "Claude Code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sessions \u2014 Selected Period",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(claude_code_session_count_total[$__range]))",
          "legendFormat": "Sessions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens by Type",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (type) (sum_over_time(claude_code_token_usage_tokens_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "options": {
        "mode": "markdown",
        "content": "**Note:** Claude Pro is a flat subscription \u2014 the cost figure above is a *notional* equivalent (what this usage would cost at standard API rates), not additional money actually spent."
      }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "5-Hour Quota Used",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (window) (claude_subscription_used_percent{window=\"5h\"})",
          "legendFormat": "5-hour window",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
